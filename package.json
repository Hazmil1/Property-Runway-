{
  "name": "property-runway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "verify:production": "tsx scripts/verify-production-readiness.ts",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "notifications:run": "tsx scripts/run-notifications.ts",
    "postinstall": "prisma generate",
    "db:bootstrap": "tsx scripts/bootstrap-workspace.ts",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "verify:config": "tsx scripts/verify-config.ts",
    "db:prepare": "tsx scripts/prepare-database.ts",
    "storage:bootstrap": "tsx scripts/bootstrap-storage.ts",
    "start:production": "sh scripts/start-production.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "csv-parse": "7.0.3",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "description": "Property and lease lifecycle operations, based on Contract Runway v0.12",
  "engines": {
    "node": ">=22.16.0"
  }
}
