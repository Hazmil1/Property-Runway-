generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  PROPERTY_MANAGER
  PROCUREMENT
  LEGAL
  PROPERTY_OWNER
  VIEWER
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  ARCHIVED
}

enum LeaseDecision {
  UNDECIDED
  RENEW
  RENEGOTIATE
  RELOCATE
  EXTEND
  TERMINATE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum DocumentStatus {
  UPLOADING
  READY
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
}

enum SuggestionStatus {
  PENDING
  CONFIRMED
  CORRECTED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TEAMS
  SLACK
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  suppliers     Supplier[]
  leases     Lease[]
  auditEvents   AuditEvent[]
  properties    Property[]
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  authUserId     String?  @unique
  email          String
  name           String
  role           UserRole @default(VIEWER)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields:[organisationId], references:[id], onDelete:Cascade)
  ownedLeases Lease[] @relation("LeaseOwner")
  managedProperties Property[] @relation("PropertyManager")
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  decidedApprovals ApprovalRequest[] @relation("ApprovalDecider")
  tasks Task[] @relation("TaskAssignee")
  runwayOverrides RunwayOverride[]
  auditEvents AuditEvent[]
  notificationEvents NotificationEvent[]
  confirmedLeases Lease[] @relation("LeaseTermsConfirmer")
  requestedLegalAmendments LegalAmendment[] @relation("LegalAmendmentRequester")
  decidedLegalAmendments LegalAmendment[] @relation("LegalAmendmentDecider")

  @@unique([organisationId,email])
  @@index([organisationId,role])
  @@index([authUserId])
}

model Supplier {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  category       String?
  strategicTier  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields:[organisationId], references:[id], onDelete:Cascade)
  leases Lease[]

  @@unique([organisationId,name])
  @@index([organisationId])
}

model Lease {
  propertyId             String?
  unit                   String?
  direction              String @default("TENANT")
  property Property? @relation(fields:[propertyId], references:[id], onDelete:Restrict)
  propertyEvents PropertyEvent[]
  id                     String           @id @default(cuid())
  organisationId         String
  supplierId             String?
  ownerId                String?
  name                   String
  reference              String?
  category               String?
  value                  Decimal?         @db.Decimal(18,2)
  currency               String           @default("GBP")
  startDate              DateTime?
  expiryDate             DateTime
  contractualNoticeDays  Int
  planningRunwayDays     Int
  legalNoticeDate        DateTime
  actionByDate           DateTime
  autoRenews             Boolean          @default(false)
  renewalPeriodMonths    Int?
  extensionOptions       String?
  status                 LeaseStatus   @default(ACTIVE)
  decision               LeaseDecision @default(UNDECIDED)
  contractualTermsConfirmedAt DateTime?
  contractualTermsConfirmedById String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organisation Organisation @relation(fields:[organisationId], references:[id], onDelete:Cascade)
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:SetNull)
  owner User? @relation("LeaseOwner", fields:[ownerId], references:[id], onDelete:SetNull)
  contractualTermsConfirmedBy User? @relation("LeaseTermsConfirmer", fields:[contractualTermsConfirmedById], references:[id], onDelete:SetNull)

  documents LeaseDocument[]
  runwayOverrides RunwayOverride[]
  approvalRequests ApprovalRequest[]
  tasks Task[]
  notificationRules NotificationRule[]
  notificationEvents NotificationEvent[]
  tenderPlan TenderPlan?
  legalAmendments LegalAmendment[]

  @@index([organisationId,status])
  @@index([organisationId,actionByDate])
  @@index([organisationId,legalNoticeDate])
  @@index([supplierId])
  @@index([ownerId])
  @@index([contractualTermsConfirmedById])
}

model LeaseDocument {
  id          String         @id @default(cuid())
  leaseId  String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  status      DocumentStatus @default(UPLOADING)
  extractionJson Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lease Lease @relation(fields:[leaseId], references:[id], onDelete:Cascade)
  clauses ClauseEvidence[]
  suggestions ExtractionSuggestion[]

  @@index([leaseId,status])
}

model ClauseEvidence {
  id          String   @id @default(cuid())
  documentId  String
  clauseType  String
  excerpt     String
  pageNumber  Int?
  confidence  Float?
  createdAt   DateTime @default(now())

  document LeaseDocument @relation(fields:[documentId], references:[id], onDelete:Cascade)

  @@index([documentId,clauseType])
}

model ExtractionSuggestion {
  id             String           @id @default(cuid())
  documentId     String
  fieldKey       String
  proposedValue  String
  correctedValue String?
  confidence     Float
  evidenceExcerpt String?
  pageNumber     Int?
  status         SuggestionStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())

  document LeaseDocument @relation(fields:[documentId], references:[id], onDelete:Cascade)

  @@index([documentId,status])
}

model RunwayOverride {
  id               String   @id @default(cuid())
  leaseId       String
  previousDays     Int
  newDays          Int
  reasonCode       String
  justification    String
  createdById      String
  approvalRequired Boolean  @default(false)
  approvalRequestId String? @unique
  createdAt        DateTime @default(now())

  lease Lease @relation(fields:[leaseId], references:[id], onDelete:Cascade)
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Restrict)
  approvalRequest ApprovalRequest? @relation("RunwayOverrideApproval", fields:[approvalRequestId], references:[id], onDelete:SetNull)

  @@index([leaseId,createdAt])
  @@index([createdById])
}

model ApprovalRequest {
  id             String         @id @default(cuid())
  leaseId     String?
  requesterId    String
  deciderId      String?
  type           String
  status         ApprovalStatus @default(PENDING)
  payload        Json
  decisionReason String?
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?

  lease Lease? @relation(fields:[leaseId], references:[id], onDelete:Cascade)
  requester User @relation("ApprovalRequester", fields:[requesterId], references:[id], onDelete:Restrict)
  decider User? @relation("ApprovalDecider", fields:[deciderId], references:[id], onDelete:SetNull)
  runwayOverride RunwayOverride? @relation("RunwayOverrideApproval")

  @@index([status,createdAt])
  @@index([leaseId])
  @@index([requesterId])
  @@index([deciderId])
}

model LegalAmendment {
  id                    String         @id @default(cuid())
  leaseId            String
  requesterId           String
  deciderId             String?
  proposedExpiryDate    DateTime?
  proposedNoticeDays    Int?
  reason                String
  status                ApprovalStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  decidedAt             DateTime?
  decisionReason        String?

  lease  Lease @relation(fields:[leaseId], references:[id], onDelete:Cascade)
  requester User @relation("LegalAmendmentRequester", fields:[requesterId], references:[id], onDelete:Restrict)
  decider   User? @relation("LegalAmendmentDecider", fields:[deciderId], references:[id], onDelete:SetNull)

  @@index([leaseId,status])
  @@index([status,createdAt])
  @@index([requesterId])
  @@index([deciderId])
}

model Task {
  id          String     @id @default(cuid())
  leaseId  String?
  assigneeId  String?
  title       String
  description String?
  dueAt       DateTime?
  status      TaskStatus @default(OPEN)
  sourceType  String?
  sourceId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lease Lease? @relation(fields:[leaseId], references:[id], onDelete:Cascade)
  assignee User? @relation("TaskAssignee", fields:[assigneeId], references:[id], onDelete:SetNull)

  @@index([assigneeId,status])
  @@index([leaseId,status])
}

model TenderPlan {
  id           String   @id @default(cuid())
  leaseId   String   @unique
  status       String   @default("PLANNING")
  targetAwardDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lease Lease @relation(fields:[leaseId], references:[id], onDelete:Cascade)
  milestones TenderMilestone[]
}

model TenderMilestone {
  id           String   @id @default(cuid())
  tenderPlanId String
  name         String
  order        Int
  durationDays Int
  startDate    DateTime?
  endDate      DateTime?
  ownerLabel   String?
  status       String   @default("NOT_STARTED")
  createdAt    DateTime @default(now())

  tenderPlan TenderPlan @relation(fields:[tenderPlanId], references:[id], onDelete:Cascade)

  @@unique([tenderPlanId,order])
}

model NotificationRule {
  id         String              @id @default(cuid())
  leaseId String
  eventType  String
  offsetDays Int                 @default(0)
  channel    NotificationChannel @default(IN_APP)
  enabled    Boolean             @default(true)
  createdAt  DateTime            @default(now())

  lease Lease @relation(fields:[leaseId], references:[id], onDelete:Cascade)

  @@index([leaseId,enabled])
}

model NotificationEvent {
  propertyEventId String?
  acknowledgedAt DateTime?
  propertyEvent PropertyEvent? @relation(fields:[propertyEventId],references:[id],onDelete:Cascade)
  id          String              @id @default(cuid())
  leaseId  String?
  userId      String?
  channel     NotificationChannel
  eventType   String
  dedupeKey   String              @unique
  scheduledFor DateTime
  payload     Json
  sentAt      DateTime?
  failedAt    DateTime?
  failureReason String?
  createdAt   DateTime            @default(now())

  lease Lease? @relation(fields:[leaseId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)

  @@index([scheduledFor,sentAt])
  @@index([leaseId])
  @@index([userId])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organisationId String
  userId          String?
  entityType      String
  entityId        String
  action          String
  beforeJson      Json?
  afterJson       Json?
  reason          String?
  createdAt       DateTime @default(now())

  organisation Organisation @relation(fields:[organisationId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)

  @@index([organisationId,createdAt])
  @@index([entityType,entityId])
  @@index([userId])
}

enum PropertyTenure {
  FREEHOLD
  LEASEHOLD
}
model Property {
  id String @id @default(cuid())
  organisationId String
  managerId String?
  name String
  reference String
  address String
  city String?
  postcode String?
  tenure PropertyTenure
  useType String @default("OFFICE")
  holdingEntity String?
  areaSqFt Decimal? @db.Decimal(18,2)
  notes String?
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
  manager User? @relation("PropertyManager",fields:[managerId],references:[id],onDelete:SetNull)
  leases Lease[]
  events PropertyEvent[]
  documents PropertyDocument[]
  @@unique([organisationId,reference])
  @@index([organisationId,archived])
  @@index([managerId])
}
model PropertyEvent {
  id String @id @default(cuid())
  propertyId String
  leaseId String?
  type String
  title String
  eventDate DateTime
  noticeDeadline DateTime
  planningDays Int @default(180)
  status String @default("OPEN")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  property Property @relation(fields:[propertyId],references:[id],onDelete:Cascade)
  lease Lease? @relation(fields:[leaseId],references:[id],onDelete:Restrict)
  notifications NotificationEvent[]
  @@index([propertyId,eventDate])
  @@index([leaseId])
}
model PropertyDocument {
  id String @id @default(cuid())
  propertyId String
  filename String
  mimeType String
  sizeBytes Int
  storageKey String @unique
  createdAt DateTime @default(now())
  property Property @relation(fields:[propertyId],references:[id],onDelete:Cascade)
  @@index([propertyId])
}
